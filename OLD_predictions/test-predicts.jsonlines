ich eingetauscht | 5</phrase></sentence><sentence><phrase> Gleich beim ersten Anblick des Hundes war<low_agentive> er | 6</low_agentive> von der Zuneigung ergriffen worden | 6</phrase><phrase> die dauern sollte bis zu<low_agentive> seinem | 7</low_agentive> letzten Atemzuge | 7</phrase></sentence><sentence><phrase><passive> Dem Herrn des schönen Tieres | 8</passive> | 8</phrase><phrase><low_agentive><low_agentive> der | 9</low_agentive> | 10</low_agentive> am Tische vor einem geleerten Branntweingläschen saß | 9</phrase><phrase> und über den Wirt schimpfte | 10</phrase><phrase> weil<low_agentive> dieser | 11</low_agentive> kein zweites umsonst hergeben wollte | 11</phrase><phrase> sah der Lump aus den Augen | 8</phrase></sentence><sentence><phrase> Ein kleiner Kerl, noch jung und doch so fahl wie ein abgestorbener Baum, mit gelbem Haar und gelbem spärlichem Barte | 12</phrase></sentence><sentence><phrase> Der Jägerrock, vermutlich ein Überrest aus der vergangenen Herrlichkeit des letzten Dienstes, trug die Spuren einer im nassen Straßengraben zugebrachten Nacht | 13</phrase></sentence></s>", "pred_aligned_text": ["<sentence>", "<copy>", "<copy>", "<copy>", "</sentence>", "<sentence>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "</sentence>", "<sentence>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "</sentence>", "<sentence>", "▁So", "▁wen", "igsten", "s", "▁mein", "t", "▁der", "▁Herr", "▁Revi", "er", "j", "äger", "<copy>", "<copy>", "</sentence>", "<sentence>", "▁Wie", "▁viel", "e", "▁Hunde", "▁hat", "▁er", "▁", "schon", "▁geha", "b", "t", "<copy>", "▁und", "▁", "auch", "▁", "gern", "▁geha", "b", "t", "<copy>", "▁aber", "▁lieb", ",", "▁was", "▁man", "▁", "sagt", "▁lie
hütz | 5</agentive> zur Antwort den Hinterlader von der Schulter reißt | 5</phrase><phrase> gibt<agentive> der Jäger | 6</agentive> Feuer | 6</phrase><phrase> All ihr Heiligen – ein sauberes Feuer! | 7</phrase></sentence><sentence><phrase> Die Flinte knackst, anstatt zu knallen | 8</phrase></sentence><sentence><phrase><low_agentive> Sie | 9</low_agentive> hat zu lange mit aufgesetzter Kapsel im feuchten Wald am Baum gelehnt | 9</phrase><phrase><low_agentive> sie | 10</low_agentive> versagt | 10</phrase></sentence><sentence><phrase> Gute Nacht, so sieht das Sterben aus | 11</phrase><phrase> denkt<low_agentive> der Alte | 12</low_agentive> | 12</phrase><phrase> Doch nein –<low_agentive> er | 13</low_agentive> ist heil | 13</phrase><phrase><low_agentive> sein | 14</low_agentive> Hut nur fliegt, von Schroten durchlöchert, ins Gras | 14</phrase><phrase> Der andere hat auch kein Glück | 15</phrase></sentence><sentence></sentence><sentence><phrase> der letzte Schuß in<agentive> seinem | 16</agentive> Gewehr | 16</phrase><phrase> und zum nächsten zieht<agentive> er | 17</agentive> eben erst die Patrone aus der Tasche | 17</phrase></sentence><sentence><phrase> ruft<agentive> Hopp | 18</agentive><agentive> seinem | 18</agentive> Hunde heiser zu | 18</phrase></sentence></s>", "pred_aligned_text": ["<sentence>", "▁Nun", "▁", "wär", "'", "s", "▁eine", "▁Passion", ",", "▁den", "▁Rack", "er", "▁nieder", "zu", "brenn", "en", "▁aus", "▁sicher", "em", "▁Hinter", "halt", "<copy>", "</sentence>", "<sentence>", "▁Aber", "▁nicht", "▁ein", "mal", "▁auf", "▁den", "▁", "schlechte", "sten", "▁Ker", "l", "▁", "schie", "ßt", "▁der", "▁J", "äger", "▁Hopp", ",", "▁", "ohne", "▁", "ihn", "▁ange", "rufen", "▁zu", "▁haben", "<copy>", "</sentence>", "<sentence>", "▁Mit", "▁", "einem", "▁Sat", "ze", "▁spring", "t", "▁er", "▁hinter", "▁dem", "▁Baum", "▁hervor", "▁und", "▁auf", "▁den", "▁Fuß", "steig", "▁und", "▁", "schreit", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>", "<copy>